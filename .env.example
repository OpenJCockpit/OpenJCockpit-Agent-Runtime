SPRING_PROFILES_ACTIVE=standalone
STANDALONE_TENANT=local

OPENAI_API_KEY=your-openai-api-key-here

ENABLE_KEYCLOAK=true
KEYCLOAK_URL=http://host.docker.internal:8080
KEYCLOAK_REALM=openjcockpit
KEYCLOAK_CLIENT_ID=openjcockpit-agent-runtime
KEYCLOAK_ISSUER=http://localhost:8080/realms/openjcockpit

LITELLM_BASE_URL=http://host.docker.internal:4000/v1
LITELLM_VIRTUAL_KEY=sk-openjcockpit-embabel-local

LLM_CODING_ROUTE=direct
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.6:27b

EMBABEL_AGENT_SERVICE_BASE_URL=
AGENT_RUNTIME_CLIENT_SECRET=

A2A_ENABLED=true
A2A_PUBLIC_BASE_URL=http://localhost:8092
